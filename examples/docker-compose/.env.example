# Copy to .env and fill in. Never commit .env.

# Email Let's Encrypt uses for certificate notices
ACME_EMAIL=you@example.com

# Google OAuth client (docker-compose.yml, docker-compose-auth-host.yml)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# OIDC client (docker-compose-oidc.yml)
OIDC_ISSUER_URL=https://login.microsoftonline.com/your-tenant-id/v2.0
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Cookie signing secret: generate with `openssl rand -hex 32`
SECRET=change-me

# Comma-separated email addresses allowed to log in
WHITELIST=you@example.com
